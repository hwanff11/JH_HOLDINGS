[Unit]
Description=JH Holdings JDSS Telegram Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVER_USER__
Group=__SERVER_USER__
WorkingDirectory=__TARGET_DIR__/current
EnvironmentFile=__TARGET_DIR__/shared/.env
Environment=PYTHONUNBUFFERED=1
Environment=JDSS_LOG_PATH=__TARGET_DIR__/shared/logs/jdss.log
Environment=JDSS_CACHE_PATH=__TARGET_DIR__/shared/data/cache
Environment=JDSS_CONFIG_PATH=__TARGET_DIR__/current/strategy.yaml
ExecStart=__TARGET_DIR__/current/.venv/bin/jdss-bot
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__TARGET_DIR__/shared

[Install]
WantedBy=multi-user.target
