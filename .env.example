# Runtime mode. Standard deploy.sh always forces dry_run.
# Live commissioning uses a separate live DB and exact confirmation phrase.
JDSS_TRADING_MODE=dry_run
JDSS_LIVE_CONFIRMATION=

# Toss Securities
TOSS_APP_KEY=
TOSS_APP_SECRET=
# API 계좌 선택 헤더에는 계좌 순번만 사용하며 전체 계좌번호는 저장하지 않습니다.
TOSS_ACCOUNT_SEQ=1

# Telegram: 보안을 위해 관리자 Chat ID 정확히 1개만 설정합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Paths
# dry-run: data/jdss.db
# live:    data/jdss-live.db (별도 신규 원장, live-preflight --arm-buy-halt 필수)
JDSS_DB_PATH=data/jdss.db
JDSS_LOG_PATH=logs/jdss.log
JDSS_CACHE_PATH=data/cache
JDSS_CONFIG_PATH=strategy.yaml

# Deployment (deploy.sh)
SSH_KEY_PATH=
# ssh-keyscan 결과를 그대로 신뢰하지 말고, Oracle 콘솔/기존 신뢰 경로로 확인한
# 서버 공개 host key가 들어 있는 known_hosts 파일을 지정합니다.
SSH_KNOWN_HOSTS_PATH=
SERVER_HOST=
SERVER_USER=ubuntu
SERVER_TARGET_DIR=/home/ubuntu/JH_HOLDINGS
SYSTEMD_SERVICE=jh_holdings_bot
REMOTE_PYTHON_BIN=python3.12
